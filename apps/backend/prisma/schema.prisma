datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MemberRole {
  CREATOR
  CO_WRITER
  EDITOR
}

enum DocType {
  STORY
  ACT
  CHAPTER
  SCENE
}

enum EntityType {
  DOCUMENT
  CHARACTER
  LOCATION
  STORY_ARC
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String          @map("password_hash")
  displayName  String          @map("display_name")
  avatarUrl    String?         @map("avatar_url")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  projects     Project[]
  memberships  ProjectMember[]

  @@map("users")
}

model Project {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String
  description        String?
  ownerId            String               @map("owner_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  owner              User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members            ProjectMember[]
  documents          Document[]
  storyArcs          StoryArc[]
  characters         Character[]
  locations          Location[]
  narrativeEmbeddings NarrativeEmbedding[]

  @@map("projects")
}

model ProjectMember {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @map("project_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      MemberRole @default(EDITOR)
  createdAt DateTime   @default(now()) @map("created_at")
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Document {
  id          String     @id @default(uuid()) @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  title       String
  type        DocType    @default(SCENE)
  position    Int        @default(0)
  contentYjs  Bytes?     @map("content_yjs")
  contentText String?    @map("content_text")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      Document?  @relation("DocumentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Document[] @relation("DocumentHierarchy")

  @@map("documents")
}

model StoryArc {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String
  description String?
  status      String   @default("PLANNING")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("story_arcs")
}

model Character {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String
  archetype   String?
  description String?
  attributes  Json?
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("characters")
}

model Location {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String
  description String?
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("locations")
}

model NarrativeEmbedding {
  id           String                      @id @default(uuid()) @db.Uuid
  projectId    String                      @map("project_id") @db.Uuid
  entityId     String                      @map("entity_id") @db.Uuid
  type         EntityType
  chunkContent String                      @map("chunk_content")
  embedding    Unsupported("vector(1536)")
  metadata     Json                        @default("{}")
  createdAt    DateTime                    @default(now()) @map("created_at")
  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("narrative_embeddings")
}
